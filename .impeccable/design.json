  "components": [
    {
      "name": "Botón primario",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "La única acción de cada paso: ancho completo, 56px, anclado al pie.",
      "html": "<button class=\"ds-btn\">Enviar código por WhatsApp</button>",
      "css": ".ds-btn{display:flex;align-items:center;justify-content:center;width:100%;height:56px;border:0;border-radius:10px;background:var(--azul,#309AE7);color:var(--negro,#0A0F1C);font:500 16px/1 var(--mono,'Plex Mono',ui-monospace,Menlo,monospace);cursor:pointer;transition:background 140ms cubic-bezier(.16,1,.3,1),transform 140ms cubic-bezier(.16,1,.3,1)} .ds-btn:hover{background:#4AA8EC} .ds-btn:active{transform:scale(.985)} .ds-btn:focus-visible{outline:2px solid var(--celeste,#5FD6FF);outline-offset:3px}"
    },
    {
      "name": "Botón deshabilitado",
      "kind": "button",
      "refersTo": "button-primary-disabled",
      "description": "Estado inactivo del botón primario.",
      "html": "<button class=\"ds-btn-off\" disabled>Conectarme</button>",
      "css": ".ds-btn-off{display:flex;align-items:center;justify-content:center;width:100%;height:56px;border:0;border-radius:10px;background:var(--g900,#161D2E);color:var(--g400,#8A93A8);font:500 16px/1 var(--mono,'Plex Mono',ui-monospace,Menlo,monospace);cursor:default}"
    },
    {
      "name": "Enlace",
      "kind": "button",
      "refersTo": "link",
      "description": "Acción secundaria en línea (Cambiar, Reenviar código).",
      "html": "<button class=\"ds-link\" type=\"button\">Reenviar código</button>",
      "css": ".ds-link{border:0;background:none;padding:0;font:500 12.5px/1.4 var(--mono,'Plex Mono',ui-monospace,monospace);color:var(--azul,#309AE7);cursor:pointer;text-decoration:underline;text-underline-offset:3px} .ds-link:hover{color:#4AA8EC} .ds-link:focus-visible{outline:2px solid var(--celeste,#5FD6FF);outline-offset:3px;border-radius:4px} .ds-link:disabled{color:var(--g400,#8A93A8);text-decoration:none;cursor:default}"
    },
    {
      "name": "Campo de línea",
      "kind": "input",
      "refersTo": "field-line",
      "description": "El dato se escribe sobre una línea de 1px, nunca en una caja.",
      "html": "<div class=\"ds-field\"><label class=\"ds-lbl\" for=\"ds-n\">Nombre y apellido</label><div class=\"ds-line\"><input id=\"ds-n\" placeholder=\"Tu nombre\"></div></div>",
      "css": ".ds-field{background:var(--negro,#0A0F1C);padding:16px} .ds-lbl{display:block;font:400 12.5px/1 var(--mono,'Plex Mono',ui-monospace,monospace);color:var(--g400,#8A93A8);margin-bottom:8px} .ds-line{border-bottom:1px solid var(--g700,#3A4358);transition:border-color 140ms cubic-bezier(.16,1,.3,1)} .ds-line:hover{border-color:var(--g400,#8A93A8)} .ds-line:focus-within{border-color:var(--azul,#309AE7)} .ds-line input{width:100%;border:0;background:none;padding:6px 0 10px;font:400 18px/1.3 var(--sans,'Plex Sans',system-ui,sans-serif);color:#fff;outline:none} .ds-line input::placeholder{color:var(--g400,#8A93A8)}"
    },
    {
      "name": "Pill de red",
      "kind": "chip",
      "refersTo": "network-pill",
      "description": "Nombre de la red en la barra superior; punto Celeste, Éxito al conectar.",
      "html": "<span class=\"ds-pill\"><i></i>Byte Invitados</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border:1px solid var(--line,#232B40);border-radius:999px;font:500 12.5px/1 var(--mono,'Plex Mono',ui-monospace,monospace);color:var(--g200,#D3D8E3);background:var(--negro,#0A0F1C)} .ds-pill i{width:7px;height:7px;border-radius:1.5px;background:var(--celeste,#5FD6FF)}"
    },
    {
      "name": "Control V/E",
      "kind": "input",
      "refersTo": "segmented-option-checked",
      "description": "Nacionalidad de la cédula, dentro de la misma línea que el número.",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\" aria-label=\"Nacionalidad\"><button class=\"on\" role=\"radio\" aria-checked=\"true\">V</button><button role=\"radio\" aria-checked=\"false\">E</button></div>",
      "css": ".ds-seg{display:inline-flex;padding:2px;border-radius:7px;background:var(--panel,#0E1424);border:1px solid var(--line,#232B40)} .ds-seg button{min-width:24px;padding:3px 5px;border:0;border-radius:5px;background:none;font:500 13px/1.2 var(--mono,'Plex Mono',ui-monospace,monospace);color:var(--g400,#8A93A8);cursor:pointer;transition:background 140ms,color 140ms} .ds-seg button:hover{color:#fff} .ds-seg button:focus-visible{outline:2px solid var(--celeste,#5FD6FF);outline-offset:1px} .ds-seg .on{background:var(--g700,#3A4358);color:#fff}"
    },
    {
      "name": "Número monumental con regla de píxeles",
      "kind": "custom",
      "refersTo": "display",
      "description": "Firma: el teléfono a escala display y la regla que se llena de azul a violeta por dígito.",
      "html": "<div class=\"ds-big\"><div class=\"ds-num\"><span class=\"ds-cc\">+58</span><span class=\"ds-n\">412 555 12</span></div><div class=\"ds-rule\"><i style=\"background:rgb(48,154,231)\"></i><i style=\"background:rgb(50,149,231)\"></i><i style=\"background:rgb(51,143,231)\"></i><i style=\"background:rgb(53,138,231)\"></i><i style=\"background:rgb(55,133,232)\"></i><i style=\"background:rgb(56,128,232)\"></i><i style=\"background:rgb(58,122,232)\"></i><i style=\"background:rgb(60,117,232)\"></i><i style=\"background:rgb(61,112,232)\"></i><i style=\"background:rgb(63,107,232)\"></i><i style=\"background:rgb(65,101,233)\"></i><i style=\"background:rgb(67,96,233)\"></i><i style=\"background:rgb(68,91,233)\"></i><i style=\"background:rgb(70,86,233)\"></i><i style=\"background:rgb(72,80,233)\"></i><i style=\"background:rgb(73,75,233)\"></i><i></i><i></i><i></i><i></i></div></div>",
      "css": ".ds-big{background:var(--negro,#0A0F1C);padding:20px} .ds-num{display:flex;align-items:baseline;gap:8px} .ds-cc{font:500 17px/1 var(--mono,'Plex Mono',ui-monospace,monospace);color:var(--g400,#8A93A8)} .ds-n{font:700 44px/1.1 var(--display,Satoshi,'Avenir Next',system-ui,sans-serif);letter-spacing:-.02em;color:#fff;font-variant-numeric:tabular-nums} .ds-rule{display:flex;gap:3px;margin-top:12px} .ds-rule i{flex:1;max-width:6px;height:6px;border-radius:1px;background:var(--line,#232B40);transition:background 140ms cubic-bezier(.16,1,.3,1)}"
    },
    {
      "name": "Celdas OTP",
      "kind": "custom",
      "refersTo": "otp-cell",
      "description": "Seis celdas monumentales sobre línea; la actual subraya en Azul Byte con cursor.",
      "html": "<div class=\"ds-otp\"><span>4</span><span>8</span><span class=\"cur\"></span><span></span><span></span><span></span></div>",
      "css": ".ds-otp{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;background:var(--negro,#0A0F1C);padding:16px} .ds-otp span{display:flex;align-items:center;justify-content:center;height:68px;border-bottom:2px solid var(--g700,#3A4358);font:700 40px/1 var(--display,Satoshi,'Avenir Next',system-ui,sans-serif);color:#fff} .ds-otp span.cur{border-color:var(--azul,#309AE7)} .ds-otp span.cur:empty::after{content:\"\";width:2px;height:34px;background:var(--azul,#309AE7);animation:ds-blink 1s steps(1) infinite} @keyframes ds-blink{50%{opacity:0}} @media (prefers-reduced-motion:reduce){.ds-otp span.cur:empty::after{animation:none}}"
    },
