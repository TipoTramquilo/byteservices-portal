# Copia este archivo a .env en la raíz (no se sube al repo) y ajusta los valores de tu PC.
# `task local:env` lo hace por ti si .env no existe.
#
# Lo leen:
#   - Task (dotenv en /Taskfile.yml): todas las tareas, incluidas `task api` y `task local:*`
#   - docker compose (`task up`): interpola docker/docker-compose.yaml
# Variables de la API: docs/reference/setup/variables-de-entorno.md

# --- API (task api y contenedor) ---

# Nombre de la red que muestra la página de registro (título y pastilla).
NETWORK_NAME="Byte Invitados"

# Zona horaria para calcular el día del registro.
TIMEZONE=America/Caracas

# Hora local (HH:MM) en que cambia el día. Define la columna day; no corta sesiones.
RESET_AT=02:00

# Enlace de "Empezar a navegar". Vacío deja el del portal.
REDIRECT=

# Abrir el acceso de verdad en un OPNsense (por ejemplo la VM de `task local:up`). Sin OPNSENSE_URL
# la API solo registra el acceso en el log. Descomentar para probar contra el equipo:
# OPNSENSE_URL=https://192.168.1.1
# OPNSENSE_SERVER_NAME=OPNsense.internal
# OPNSENSE_ZONE=0
# OPNSENSE_KEY=cambiar-por-la-key
# OPNSENSE_SECRET=cambiar-por-el-secret

# Solo en el despliegue sobre OPNsense (ver docs/reference/setup/opnsense.md). Aquí cambiarían
# `task api`: el puerto, la base y la carpeta del portal son las del equipo, no las de tu PC.
# ADDR=127.0.0.1:8085
# DB=/var/db/byte/portal.db
# PORTAL_DIR=/usr/local/www/byte

# --- Contenedor (task up) ---

# Puerto del host donde se publica el portal.
PORTAL_PORT=8080

# --- Entorno local: host (task local:*) ---

# Tarjeta cableada del PC. Se convierte en el puente br0, que da internet a la WAN de la VM.
# Mira el nombre con: ip -br link
WAN_NIC=enp5s0

# Tarjeta Wi-Fi del PC. Será el AP "Byte" (hostapd) para los visitantes.
WIFI_NIC=wlp0s20f3

# Nombre de la conexión Wi-Fi de NetworkManager que se suelta para liberar la tarjeta.
# Vacío = no tocar la conexión Wi-Fi.
WIFI_CON=

# Nombre de la red Wi-Fi que emite el AP (SSID). Red abierta, sin contraseña.
SSID=Byte
