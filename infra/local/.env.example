# Copia este archivo a .env (no se sube al repo) y ajusta los valores de tu PC.
# `task env` lo hace por ti si .env no existe.
# Las variables de host las lee el Taskfile; las de la API son las mismas que usa apps/api
# (docs/reference/setup/variables-de-entorno.md) y se pasan a la VM cuando haga falta.

# --- Host (Taskfile) ---

# Tarjeta cableada del PC. Se convierte en el puente br0, que da internet a la WAN de la VM.
# Mira el nombre con: ip -br link
WAN_NIC=enp5s0

# Tarjeta Wi-Fi del PC. Será el AP "Byte" (hostapd) para los visitantes.
WIFI_NIC=wlp0s20f3

# Nombre de la conexión Wi-Fi de NetworkManager que se suelta para liberar la tarjeta.
# Vacío = no tocar la conexión Wi-Fi.
WIFI_CON=

# Nombre de la red Wi-Fi que emite el AP (SSID). Red abierta, sin contraseña.
SSID=Byte

# --- API (valores de prueba; no son reales) ---

# Dirección donde escucha la API. En OPNsense va 127.0.0.1:8085 (lo que espera lighttpd).
ADDR=127.0.0.1:8085

# Archivo SQLite donde se guardan los registros de visitantes.
DB=/var/db/byte/portal.db

# Carpeta con el portal compilado (index.html y fuentes) que sirve la API.
PORTAL_DIR=/usr/local/www/byte

# Zona horaria para calcular el día del registro.
TIMEZONE=America/Caracas

# Hora local (HH:MM) en que cambia el día. Define la columna day; no corta sesiones.
RESET_AT=02:00

# Nombre de la red que muestra la página de registro (título y pastilla).
NETWORK_NAME="Byte Invitados"

# URL de la GUI de OPNsense que usa la API para abrir el acceso (sin ella, solo registra en el log).
OPNSENSE_URL=http://127.0.0.1

# Nombre que trae el certificado de la GUI. Hace falta si OPNSENSE_URL usa una IP.
OPNSENSE_SERVER_NAME=OPNsense.internal

# ID de la zona del portal cautivo en OPNsense (normalmente 0).
OPNSENSE_ZONE=0

# Key de la API de OPNsense del usuario que abre el acceso (System → Access → Users → API keys).
OPNSENSE_KEY=cambiar-por-la-key

# Secret de esa key. Va con la key; no lo subas nunca al repo real.
OPNSENSE_SECRET=cambiar-por-el-secret
