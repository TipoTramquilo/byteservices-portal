# FASE 1: nombre de rama (instantáneo)
# shellcheck source=branch-name.sh
. "$(dirname "$0")/branch-name.sh"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if ! branch_ok "$BRANCH"; then
  echo ""
  echo "✖ Push cancelado: nombre de rama inválido ('$BRANCH')"
  branch_help
  echo ""
  exit 1
fi

# FASE 2: lo mismo que CI salvo la imagen. Si pasa aquí, CI no debería romperse por lint, formato o tests
task check
