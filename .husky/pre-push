#!/usr/bin/env bash
set -e

# FASE 1: Branch name validation (instantaneous)
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if [ "$BRANCH" != "main" ] && [ "$BRANCH" != "develop" ] && [ "$BRANCH" != "staging" ]; then
  if ! echo "$BRANCH" | grep -qE '^(feature|fix|refactor|hotfix|chore|docs)/[a-z0-9-]+$'; then
    echo ""
    echo "✖ Push aborted: invalid branch name."
    echo "  Current branch: $BRANCH"
    echo "  Expected format: <type>/<scope|-|description>"
    echo "  Valid types: feature|fix|refactor|hotfix|chore|docs"
    echo "  Example: feature/scrum-101-new-endpoint"
    echo "  Create it correctly with: git checkout -b <type>/<description>"
    echo ""
    exit 1
  fi
fi

# FASE 2: Full quality gate (same checks as CI)
task check
