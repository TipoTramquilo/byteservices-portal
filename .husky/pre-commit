# FASE 1: Secret scan (trufflehog)
STAGED_DIFF=$(git diff --cached --diff-filter=d)
if [ -n "$STAGED_DIFF" ]; then
  if command -v trufflehog >/dev/null 2>&1; then
    echo "$STAGED_DIFF" | trufflehog stdin --only-verified --fail
    # shellcheck disable=SC2181
    if [ $? -ne 0 ]; then
      echo "✖ trufflehog detected an active secret in the staged files. Commit aborted."
      exit 1
    fi
  else
    echo ""
    echo "⚠ trufflehog is NOT installed. Secret scan skipped."
    echo "  Why trufflehog?: It detects and verifies hardcoded secrets"
    echo "  (API keys, tokens, passwords) before they are committed."
    echo "  Optional but strongly recommended."
    echo "  Install:  https://trufflesecurity.com/trufflehog"
    echo "  Repo:     https://github.com/trufflesecurity/trufflehog"
    echo ""
  fi
fi

# FASE 2: Autofix and formatting (linters on staged files)
pnpm exec lint-staged
