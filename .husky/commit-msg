#!/usr/bin/env sh

MESSAGE_FILE="$1"

if pnpm exec commitlint --edit "$MESSAGE_FILE"; then
  exit 0
fi

echo ""
echo "✖ Commit message rejected by commitlint."
echo "  Required format (Conventional Commits):"
echo "    <type>(<optional scope>): <description>"
echo "  Valid types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
echo "  Examples:"
echo "    feat(api): add user login endpoint"
echo "    fix: correct price rounding"
echo "    chore: update dependencies"
echo "  Type the message directly; commitlint validates it."
echo ""
exit 1
