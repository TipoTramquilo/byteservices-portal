{
  "name": "byteservices-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node apps/web/build.mjs",
    "fonts": "node apps/web/subset-fonts.mjs",
    "lint": "oxlint --max-warnings=0 .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "es-check": "es-check es2020 apps/web/src/app.mjs --checkFeatures",
    "audit:deps": "pnpm audit --audit-level=high",
    "audit:signatures": "pnpm audit signatures",
    "check": "pnpm lint && pnpm format:check && pnpm es-check && pnpm build",
    "preinstall": "node -e \"if(!process.env.npm_config_user_agent?.includes('pnpm')){console.error('\\n\\u2716 Usa pnpm: pnpm install\\n');process.exit(1)}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "es-check": "9.9.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "subset-font": "2.9.0"
  },
  "lint-staged": {
    "*.{mjs,css,json,md,yml,yaml}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.mjs": [
      "oxlint --fix --max-warnings=0"
    ],
    "apps/web/src/*.mjs": [
      "es-check es2020 --checkFeatures"
    ],
    "apps/api/**/*.go": [
      "gofmt -w"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.23.0"
}
